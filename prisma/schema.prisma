generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  refreshToken RefreshToken?
  isBlocked    Boolean? @default(false)
  dtIniPremium DateTime?
  dtFimPremium DateTime?
  stripeCliId  String?  @unique
  stripeSubId  String?  @unique
  statusAss    String   @default("inativo") // "ativo", "cancelado", "pendente"
  plano        String?  // "mensal", "anual", "semestral"
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  @@index([stripeCliId])
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  expiresIn     Int
  user          Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate:   Cascade)
  userId        String   @unique
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Conteudo {
  id             Int      @id @default(autoincrement())
  nome           String?  @unique
  name           String?  @unique
  link           String?
  filename       String
  mimetype       String
  data           Bytes
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  Categoria      Categoria[]
}
 // @@index([nome])

model Categoria {
  id             Int      @id @default(autoincrement())
  nome           String?  @unique
  name           String?  @unique
  descricao      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  conteudos      Conteudo[]
}